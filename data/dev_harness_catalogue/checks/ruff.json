{
  "id": "ruff",
  "schema_version": 1,
  "tool_version": "0.13.3",
  "report_contract": "ruff-json-v1",
  "args": [
    "check",
    "--no-cache",
    "--output-format=json",
    "{targets}"
  ],
  "configured_command": false,
  "version_args": [
    "--version"
  ],
  "fail_codes": [
    1
  ],
  "release_source": "https://github.com/astral-sh/ruff/releases/tag/0.13.3",
  "coverage": "native_command_only",
  "installation": "already_installed_only",
  "config_globs": [
    "package.json",
    "*lock*.json",
    "*lock*.yaml",
    "pyproject.toml",
    "ruff.toml",
    ".ruff.toml",
    "**/ruff.toml",
    "**/.ruff.toml",
    "**/pyproject.toml"
  ]
}
