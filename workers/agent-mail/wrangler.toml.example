# Copy to wrangler.toml and fill in your own values. Never commit the copy.
#
# This template is disabled (MAIL_ENABLED = "false"). Do not deploy or enable
# until the provider-fixture, retention, domain-namespace and privacy gates are
# met. The transport contract is docs/AGENT_MAIL_PULL_CONTRACT.md;
# docs/AGENT_MAIL_TRANSPORT.md describes the retired push transport.
name = "clayrune-agent-mail"
main = "production.js"
compatibility_date = "2026-11-01"

[vars]
MAIL_ENABLED = "false"
MAIL_INGRESS_VERIFIED = "false"
MAIL_DOMAIN = "mail.example.net"
MAIL_FROM = "agent@mail.example.net"
MAIL_SERVICE_KEY_ID = "mail-service-v1"
# Pull socket: reviewed origin and pin deadline (positive 13-digit Unix ms).
# Required before unit 14 enables pull routing; no request may set these values.
# MAIL_SERVICE_ORIGIN = "https://mail.example.net"
# MAIL_SERVICE_PIN_EXPIRES_MS = "REVIEWED_PIN_EXPIRY_MS"
# Socket expiry is min(pin deadline, signed manifest expiry, key retirement).
# Renew reviewed config before that deadline; no automatic pin/key renewal.
# Hosted self-serve signup admission (MC-1166 U7). Only the exact string "open" lets NEW
# signups start (10 per UTC day, 10 live pending); absent or any other value is closed.
# Closed still serves replays, status and confirmation of already-admitted signups.
# MAIL_SIGNUP_ADMISSION = "open"
# Signup verification mail needs MAIL_PULL_OUTBOX_KEY (Worker secret: 32 random bytes,
# base64url) and MAIL_PULL_OUTBOX_KEY_ID (a plain var, e.g. "outbox-v1"). The minute cron
# sends queued verification mail only when both are set; without them it just sweeps.
# MAIL_PULL_OUTBOX_KEY_ID = "outbox-v1"
# Set the 32-hex account id in your operator copy before enabling enrollment.
# MAIL_DESTINATION_ACCOUNT_ID = "YOUR_ACCOUNT_ID"
# MAIL_DESTINATION_TOKEN is a human-created Worker secret, account-scoped with
# Email Routing Addresses Write + Read. Never store the token in TOML.
# MAIL_SERVICE_PRIVATE_KEY is a Worker secret: base64url PKCS#8 Ed25519.
# Never put a private key in this file or registration rows.
# MAIL_SERVICE_MANIFEST is a plain var (public by design, NOT a secret): the one-line JSON
# {"manifest":[...],"signature":"..."} printed by tools/agent-mail-manifest-sign.py, signed OFFLINE
# with the root key. Set it in your own copy or the dashboard; the Worker only serves it.
# Unset, it answers 503 manifest_not_configured. Never put the root key anywhere near this file.

[[d1_databases]]
binding = "MAIL_DB"
database_name = "agent-mail"
database_id = "REPLACE_ONLY_AFTER_DEPLOY_APPROVAL"
# Apply schema.sql then every file in migrations/ (0001 through 0006), in order,
# before enablement. Without 0005_pull.sql no pull table exists and every
# /v1/pull/* request answers 503.

[[send_email]]
name = "MAIL_SEND"
# Do not set destination_address or allowed_destination_addresses: Cloudflare
# permits the account's verified destinations; app code enforces the exact owner.

[[durable_objects.bindings]]
name = "MAIL_PULL_MAILBOX"
class_name = "PullSocketMailbox"

[[migrations]]
tag = "pull-mailbox-v1"
new_sqlite_classes = ["PullSocketMailbox"]

[triggers]
crons = ["* * * * *"]

# Real account id, zone id, destination addresses and routing rules belong in
# your own wrangler.toml / dashboard, never in this repo.
