  "routes": [
    {
      "id": "tiktok-direct-post",
      "title": "Post a video straight to your TikTok profile (Content Posting API)",
      "guidance": "Posts to your profile through a TikTok app. Until TikTok audits the app, everything it posts is private to you, and TikTok's audit rules exclude a tool that posts to accounts you or your team run. Clayrune has no flow for it.",
      "transport": "api",
      "support": "restricted",
      "auth": [
        {
          "type": "oauth",
          "params": [],
          "placement": "header",
          "scopes": [
            "video.publish"
          ],
          "issuer": "TikTok",
          "registration": "Register an app at developers.tiktok.com, get video.publish approved, and have the account owner authorize it.",
          "claim": "tt.direct"
        }
      ],
      "coverage": [
        {
          "purpose": "publish",
          "account_kind": "account",
          "capability": "post",
          "status": "documented",
          "claim": "tt.direct"
        },
        {
          "purpose": "publish",
          "account_kind": "account",
          "capability": "media",
          "status": "documented",
          "claim": "tt.direct"
        }
      ],
      "requirements": [
        {
          "kind": "developer_app",
          "text": "A TikTok developer app approved for the video.publish scope, authorized by the account owner.",
          "claim": "tt.direct"
        },
        {
          "kind": "provider_review",
          "text": "An audit of the app lifts the private-only restriction. Unaudited apps can post only as SELF_ONLY to accounts set to private, for at most 5 users in 24 hours.",
          "claim": "tt.audit"
        },
        {
          "kind": "permitted_use",
          "text": "TikTok's guidelines name \"a utility tool to help upload contents to the account(s) you or your team manages\" as unacceptable, and require a client aimed at a wide audience.",
          "claim": "tt.use"
        }
      ],
      "limits": [
        {
          "name": "Requests per user access token",
          "source": "provider",
          "value": "6",
          "unit": "requests per minute",
          "reset": null,
          "claim": "tt.rate"
        },
        {
          "name": "Posts per creator account per day",
          "source": "provider",
          "value": "about 15, shared across all Direct Post clients",
          "unit": null,
          "reset": null,
          "claim": "tt.use"
        }
      ],
      "cost": {
        "basis": "unknown",
        "items": []
      },
      "evidence": [
        "tiktok-direct-post-guide",
        "tiktok-sharing-guidelines",
        "tiktok-direct-post-reference"
      ]
    },
