# Cloudflare Pages headers config for clayrune.io.
#
# Two jobs:
#   1. correct Content-Type for the installer files so browsers don't try to
#      render them as HTML when a user pastes the URL into the address bar;
#   2. EDGE CACHING for the marketing site + demo bundle (added 2026-08-07).
#
# Why (2) exists — measured, not guessed. Cloudflare Pages' default response is
# `Cache-Control: public, max-age=0, must-revalidate` with
# `cf-cache-status: DYNAMIC`, i.e. NOTHING is cached at the edge and every
# single visitor hit goes all the way to the Pages asset origin. When that
# origin is cold for a given colo it times out, and Cloudflare answers 504.
# Zone analytics for the 24h to 2026-08-07T11:55Z:
#
#     /                       176 x 200   20 x 504   (~10% of homepage loads)
#     /demo/demo-app.html      89 x 308   20 x 504   (~18%)
#     /demo/demo-app           86 x 200   22 x 504   (~20%)
#     /blog.html                5 ok       5 x 504
#     /docs.html                4 ok       3 x 504
#     /download                 4 ok       4 x 504
#
# It is colo-dependent, which is why it does not reproduce from the dev box
# (49/49 curl + 14/14 headless-Chromium loads succeeded while the zone was
# logging those 504s). `stale-while-revalidate` is the load-bearing directive:
# it lets the edge serve a slightly stale copy INSTANTLY instead of blocking on
# a cold origin and 504-ing. `s-maxage` is what actually makes Cloudflare's CDN
# hold the object at all.
#
# Rules are enumerated per path rather than using `/*` on purpose: a `/*` rule
# would also match the installer entries below and the merge order for a
# duplicated header is not something worth betting the download path on.

# install.sh / install.ps1 are served as attachments rather than text/plain.
# A user who opens https://clayrune.io/install.sh in a browser used to see
# the raw script body, and a tempting "select all + copy + paste into
# Terminal" path. zsh chokes on the `!` in `#!/usr/bin/env sh` (history
# expansion → `event not found: /usr/bin/env`) and the install never runs.
# Forcing a download means the only viable execution path is the canonical
# one-liner `curl -sSL https://clayrune.io/install.sh | sh`, which curl
# happily honors regardless of these headers.
/install.sh
  Content-Type: application/octet-stream
  Content-Disposition: attachment; filename="install.sh"
  Cache-Control: public, max-age=300

/install.ps1
  Content-Type: application/octet-stream
  Content-Disposition: attachment; filename="install.ps1"
  Cache-Control: public, max-age=300

/install-prompt.md
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300

/start.sh
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300

/start.command
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300

/start.bat
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300

# Double-click installer wrappers — served as octet-stream so they download
# instead of rendering as text in the browser. The `download` attribute on
# the anchor would suffice in modern browsers, but this is belt + suspenders.
/Clayrune-Setup.bat
  Content-Type: application/octet-stream
  Content-Disposition: attachment; filename="Clayrune-Setup.bat"
  Cache-Control: public, max-age=300

/Clayrune-Setup.command
  Content-Type: application/octet-stream
  Content-Disposition: attachment; filename="Clayrune-Setup.command"
  Cache-Control: public, max-age=300


# ── Demo bundle ──────────────────────────────────────────────────────────────
# Every asset here is cache-busted by an explicit ?v=rNN in its referencing
# markup, so a long edge TTL is safe: a new revision changes the URL. This is
# the highest-value rule in the file — the demo is what a Show HN visitor is
# sent to, and it currently fails ~1 load in 5.
/demo/*
  Cache-Control: public, max-age=600, s-maxage=86400, stale-while-revalidate=604800

# ── Marketing pages ──────────────────────────────────────────────────────────
# Short browser TTL so an edit is picked up quickly, and a SHORT edge TTL with a
# long stale-while-revalidate. SWR is what keeps a cold Pages origin from ever
# turning into a 504 for a real visitor: once s-maxage lapses the edge still
# answers instantly from its stale copy and revalidates in the BACKGROUND, so
# nobody ever waits on the origin. The freshness window therefore costs us
# nothing and s-maxage does not need to be long.
#
# It was s-maxage=3600 until 2026-08-08 and that hour was a real problem: a
# Pages deploy does NOT purge this cache key, so every ship left visitors on the
# previous HTML for up to an hour. Measured twice — 44 minutes once, and Age
# 1077/3600 with the old page still being served while the fix sat at the
# origin. Versioned assets (?v=) self-heal because the URL changes; the HTML
# entry point cannot, so it must expire quickly instead.
#
# Both the extensionless and .html forms are listed because Pages serves both
# and 504s were logged against each.
/
  Cache-Control: public, max-age=60, s-maxage=60, stale-while-revalidate=604800
/index.html
  Cache-Control: public, max-age=60, s-maxage=60, stale-while-revalidate=604800
/demo
  Cache-Control: public, max-age=60, s-maxage=60, stale-while-revalidate=604800
/demo.html
  Cache-Control: public, max-age=60, s-maxage=60, stale-while-revalidate=604800
/download
  Cache-Control: public, max-age=60, s-maxage=60, stale-while-revalidate=604800
/download.html
  Cache-Control: public, max-age=60, s-maxage=60, stale-while-revalidate=604800
/docs
  Cache-Control: public, max-age=60, s-maxage=60, stale-while-revalidate=604800
/docs.html
  Cache-Control: public, max-age=60, s-maxage=60, stale-while-revalidate=604800
/blog
  Cache-Control: public, max-age=60, s-maxage=60, stale-while-revalidate=604800
/blog.html
  Cache-Control: public, max-age=60, s-maxage=60, stale-while-revalidate=604800
/blog-managing-agents.html
  Cache-Control: public, max-age=60, s-maxage=60, stale-while-revalidate=604800
/blog-what-is-clayrune.html
  Cache-Control: public, max-age=60, s-maxage=60, stale-while-revalidate=604800
/blog-why-a-mobile-app.html
  Cache-Control: public, max-age=60, s-maxage=60, stale-while-revalidate=604800
/privacy.html
  Cache-Control: public, max-age=60, s-maxage=60, stale-while-revalidate=604800

# ── Site static assets ───────────────────────────────────────────────────────
/styles.css
  Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800
/page.css
  Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800
/demo.css
  Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800
/app.js
  Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800
/demo.js
  Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800
/assets/*
  Cache-Control: public, max-age=86400, s-maxage=604800, stale-while-revalidate=604800

# ── Never cache ──────────────────────────────────────────────────────────────
# Conversion beacons. They are POSTs to a static host, so Pages answers 405 —
# that is fine and by design, the hit is still counted in zone analytics — but
# the response must never be held at the edge or the count goes flat.
/e/*
  Cache-Control: no-store
# Crawler files: cheap, and a stale sitemap is worse than an origin fetch.
/robots.txt
  Cache-Control: public, max-age=300
/sitemap.xml
  Cache-Control: public, max-age=300
